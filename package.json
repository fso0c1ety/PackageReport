{
  "name": "client",
  "version": "1.0.11",
  "description": "Smart Manage universal work management platform",
  "author": "Aximo Studio",
  "private": true,
  "smartManage": {
    "androidVersionCode": 10000
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/prepare-capacitor-webdir.js",
    "vercel-build": "node scripts/vercel-build.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:ci": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "db:migrate": "node server/db/runMigrations.js",
    "demo:seed": "node scripts/seed-marketing-demo.mjs",
    "demo:seed-portals": "node scripts/seed-portal-acceptance.mjs",
    "demo:prepare-portals": "node scripts/prepare-portal-acceptance-env.mjs",
    "demo:verify-db": "node scripts/verify-demo-database-target.mjs",
    "demo:screenshots": "node scripts/marketing-screenshots.mjs",
    "files:migrate": "node scripts/migrate-files-to-object-storage.js",
    "start": "set NODE_ENV=production&& node server/index.js",
    "start-server": "set SKIP_NEXT_APP=true&& set NODE_ENV=development&& nodemon server/index.js",
    "lint": "eslint",
    "desktop:build": "npm run build && npx electron-builder --win nsis --publish never --config.npmRebuild=false",
    "desktop:pack": "npm run build && npx electron-builder --win --dir --publish never --config.npmRebuild=false"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/fcm": "^8.1.0",
    "@capacitor/android": "8.3.0",
    "@capacitor/cli": "8.3.0",
    "@capacitor/core": "8.3.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@date-io/dayjs": "^3.2.0",
    "@emailjs/browser": "^4.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.7",
    "@mui/x-date-pickers": "^8.26.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-virtual": "^3.14.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.6",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.34.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.32.0",
    "multer": "^2.1.0",
    "next": "16.3.0",
    "node-fetch": "^2.7.0",
    "openai": "^6.33.0",
    "pg": "^8.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-flagkit": "^2.0.4",
    "recharts": "^3.7.0",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "typescript": "^5",
    "uuid": "^13.0.0",
    "world-countries": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.5.2",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^37.7.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4"
  },
  "build": {
    "appId": "com.packagereport.desktop",
    "productName": "Smart Manage",
    "icon": "electron/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "Smart Manage.mp4",
        "to": "assets/Smart Manage.mp4"
      }
    ],
    "asar": true,
    "win": {
      "icon": "electron/icon.ico",
      "artifactName": "Smart-Manage-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fso0c1ety",
        "repo": "PackageReport",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
